# Example .env for local development (DO NOT commit real secrets)
# Copy this file to .env and fill with real values (do NOT commit .env)

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=desafio
POSTGRES_USER=desafio
POSTGRES_PASSWORD=CHANGE_ME

# JWT secret (base64 or plain string)
JWT_SECRET_KEY=change_this_secret_for_local_development

