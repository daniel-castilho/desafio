# =================================================
# Environment variables for local and Docker setup
# =================================================

# --- For Docker Compose to initialize the Postgres container ---
POSTGRES_DB=desafio
POSTGRES_USER=desafio
POSTGRES_PASSWORD=desafio

# --- For local IDE execution (via EnvFile plugin) ---
# Standard Spring Boot Datasource Properties
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/desafio
SPRING_DATASOURCE_USERNAME=desafio
SPRING_DATASOURCE_PASSWORD=desafio

# --- JWT Secret (used by both environments) ---
JWT_SECRET_KEY=jwtsecret25